generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

model Organizacao {
  id                  String       @id @default(uuid()) @db.Uuid
  razaoSocial         String
  cnpj                String       @unique
  inscricaoEstadual   String
  enderecoCompleto   String
  telefone            String
  email               String
  dataCadastro        DateTime     @default(now())
  ativo               Boolean      @default(true)
  contratoVigente     Contrato?
  lotes               Lote[]
}

model Contrato {
  id                 String       @id @default(uuid()) @db.Uuid
  organizacaoId      String       @unique @db.Uuid
  dataAssinatura     DateTime
  dataVencimento     DateTime
  clausulas          String[]
  valorMensal        Decimal      @db.Decimal(12, 2)
  renovacaoAutomatica Boolean
  organizacao        Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
}

model Lote {
  id                  String       @id @default(uuid()) @db.Uuid
  dataEntrada         DateTime
  organizacaoId       String       @db.Uuid
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote   @default(RECEBIDO)
  observacoes         String       @default("")
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  equipamentos        Equipamento[]

  @@index([organizacaoId, dataEntrada])
}

model Equipamento {
  id                     String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno    String             @unique
  tipo                   TipoEquipamento
  marca                  String
  modelo                 String
  anoFabricacao          Int
  estadoFisico           EstadoFisico
  pesoQuilogramas        Decimal            @db.Decimal(10, 3)
  loteId                 String             @db.Uuid
  posicaoNoLote          Int
  statusRastreamento     StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  lote                   Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  historicoMovimentacao  Movimentacao[]

  @@index([loteId, posicaoNoLote])
}

model Movimentacao {
  id             String      @id @default(uuid()) @db.Uuid
  equipamentoId  String      @db.Uuid
  dataHora       DateTime    @default(now())
  origem         String
  destino        String
  responsavel    String
  observacao     String      @default("")
  equipamento    Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@index([equipamentoId, dataHora])
}

model Credencial {
  id            String       @id @default(uuid()) @db.Uuid
  usuario       String       @unique
  hashSenha     String
  salt          String
  ultimoAcesso  DateTime?
  papel         PapelUsuario @default(OPERADOR_CADASTRO)
}
